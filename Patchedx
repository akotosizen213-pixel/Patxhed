    Sub.Position           = UDim2.new(0, 14, 0.52, 0)
    Sub.TextXAlignment     = Enum.TextXAlignment.Left
    Sub.Parent             = Row

    local ToggleBG = Instance.new("Frame")
    ToggleBG.Size             = UDim2.new(0, 44, 0, 24)
    ToggleBG.Position         = UDim2.new(1, -58, 0.5, -12)
    ToggleBG.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    ToggleBG.BorderSizePixel  = 0
    ToggleBG.Parent           = Row
    Instance.new("UICorner", ToggleBG).CornerRadius = UDim.new(1, 0)

    local Dot = Instance.new("Frame")
    Dot.Size             = UDim2.new(0, 18, 0, 18)
    Dot.Position         = UDim2.new(0, 3, 0.5, -9)
    Dot.BackgroundColor3 = Color3.fromRGB(120, 120, 120)
    Dot.BorderSizePixel  = 0
    Dot.Parent           = ToggleBG
    Instance.new("UICorner", Dot).CornerRadius = UDim.new(1, 0)

    local function Refresh(on)
        local ti = TweenInfo.new(0.15, Enum.EasingStyle.Quad)
        TweenService:Create(Dot, ti, {
            Position         = on and UDim2.new(0, 23, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
