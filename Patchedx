        TweenService:Create(ToggleBG, ti, {
            BackgroundColor3 = on and Color3.fromRGB(60,60,60) or Color3.fromRGB(40,40,40),
        }):Play()
    end

    Refresh(Settings[settingKey])

    local Click = Instance.new("TextButton")
    Click.Size                 = UDim2.new(1, 0, 1, 0)
    Click.BackgroundTransparency = 1
    Click.Text                 = ""
    Click.Parent               = Row
    Click.MouseButton1Click:Connect(function()
        Settings[settingKey] = not Settings[settingKey]
        Refresh(Settings[settingKey])
    end)
end

-- ══════════════════════════════════════════
--  SLIDER COMPONENT  — FULLY REWRITTEN
--  Fixed: InputBegan on Track misses fast drags;
--         now uses a transparent overlay Button
--         that captures the initial click precisely,
--         then global InputChanged drives the drag.
-- ══════════════════════════════════════════
local function MakeSlider(parent, labelText, settingKey, minVal, maxVal, order, isFloat, callback)
    local Row = Instance.new("Frame")
    Row.LayoutOrder      = order
    Row.Size             = UDim2.new(1, -8, 0, 72)
    Row.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Row.BorderSizePixel  = 0
    Row.Parent           = parent
    Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 10)
    local RS = Instance.new("UIStroke", Row)
    RS.Color = Color3.fromRGB(40, 40, 40); RS.Thickness = 1

    local function FmtVal(v)
        return isFloat and string.format("%.2f", v) or tostring(math.floor(v))
    end

    local Lbl = Instance.new("TextLabel")
    Lbl.Text               = labelText
    Lbl.Font               = Enum.Font.GothamBold
    Lbl.TextSize           = 13
    Lbl.TextColor3         = Color3.fromRGB(255, 255, 255)
    Lbl.BackgroundTransparency = 1
    Lbl.Size               = UDim2.new(0.65, 0, 0, 22)
    Lbl.Position           = UDim2.new(0, 14, 0, 8)
    Lbl.TextXAlignment     = Enum.TextXAlignment.Left
    Lbl.Parent             = Row

    local ValLbl = Instance.new("TextLabel")
    ValLbl.Text               = FmtVal(Settings[settingKey])
    ValLbl.Font               = Enum.Font.GothamBold
    ValLbl.TextSize           = 12
    ValLbl.TextColor3         = Color3.fromRGB(180, 180, 180)
    ValLbl.BackgroundTransparency = 1
    ValLbl.Size               = UDim2.new(0.35, -14, 0, 22)
    ValLbl.Position           = UDim2.new(0.65, 0, 0, 8)
    ValLbl.TextXAlignment     = Enum.TextXAlignment.Right
    ValLbl.Parent             = Row

    -- Track background
    local Track = Instance.new("Frame")
    Track.Size             = UDim2.new(1, -28, 0, 8)
    Track.Position         = UDim2.new(0, 14, 0, 44)
    Track.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    Track.BorderSizePixel  = 0
    Track.Parent           = Row
    Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

    local initPct = math.clamp((Settings[settingKey] - minVal) / (maxVal - minVal), 0, 1)

    local Fill = Instance.new("Frame")
    Fill.Size             = UDim2.new(initPct, 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(210, 210, 210)
    Fill.BorderSizePixel  = 0
    Fill.Parent           = Track
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame")
    Knob.Size             = UDim2.new(0, 16, 0, 16)
    Knob.AnchorPoint      = Vector2.new(0.5, 0.5)
    Knob.Position         = UDim2.new(initPct, 0, 0.5, 0)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.BorderSizePixel  = 0
    Knob.Parent           = Track
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    -- Invisible click catcher over the whole row
    local Catcher = Instance.new("TextButton")
    Catcher.Size                 = UDim2.new(1, 0, 1, 0)
    Catcher.BackgroundTransparency = 1
    Catcher.Text                 = ""
    Catcher.ZIndex               = 10
    Catcher.Parent               = Row

    local dragging = false

    local function Compute(inputX)
        -- use Track's absolute position for accuracy
        local trackAbs   = Track.AbsolutePosition.X
        local trackWidth = Track.AbsoluteSize.X
        local pct        = math.clamp((inputX - trackAbs) / trackWidth, 0, 1)
        local raw        = minVal + (maxVal - minVal) * pct
        local val        = isFloat and math.floor(raw * 100 + 0.5) / 100 or math.floor(raw + 0.5)
        Settings[settingKey] = val
        ValLbl.Text          = FmtVal(val)
        Fill.Size            = UDim2.new(pct, 0, 1, 0)
        Knob.Position        = UDim2.new(pct, 0, 0.5, 0)
        if callback then callback(val) end
    end

    Catcher.MouseButton1Down:Connect(function(x, _y)
        dragging = true
        Compute(x)
    end)

    -- global move so drag still works when cursor leaves the row
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            Compute(input.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)

    return Row
end

-- ══════════════════════════════════════════
--  COLOR PICKER  (MISC tab)
-- ══════════════════════════════════════════
local function MakeColorPicker(parent, order)
    local Row = Instance.new("Frame")
    Row.LayoutOrder      = order
    Row.Size             = UDim2.new(1, -8, 0, 160)
    Row.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    Row.BorderSizePixel  = 0
    Row.Parent           = parent
    Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 10)
    local RS = Instance.new("UIStroke", Row); RS.Color = Color3.fromRGB(40,40,40); RS.Thickness = 1

    local TitleLbl = Instance.new("TextLabel")
    TitleLbl.Text               = "GUI ACCENT COLOR"
    TitleLbl.Font               = Enum.Font.GothamBold
    TitleLbl.TextSize           = 13
    TitleLbl.TextColor3         = Color3.fromRGB(255,255,255)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Size               = UDim2.new(1,-14,0,22)
    TitleLbl.Position           = UDim2.new(0,14,0,8)
    TitleLbl.TextXAlignment     = Enum.TextXAlignment.Left
    TitleLbl.Parent             = Row

    local Preview = Instance.new("Frame")
    Preview.Size             = UDim2.new(0,30,0,30)
    Preview.Position         = UDim2.new(1,-44,0,8)
    Preview.BackgroundColor3 = Settings.GUIColor
    Preview.BorderSizePixel  = 0
    Preview.Parent           = Row
    Instance.new("UICorner", Preview).CornerRadius = UDim.new(0,6)

    local defs = {
        {l="R", k="r", c=Color3.fromRGB(200,60,60)},
        {l="G", k="g", c=Color3.fromRGB(60,200,60)},
        {l="B", k="b", c=Color3.fromRGB(60,120,200)},
    }
    local cv = {
        r = math.floor(Settings.GUIColor.R * 255),
        g = math.floor(Settings.GUIColor.G * 255),
        b = math.floor(Settings.GUIColor.B * 255),
    }

    local function Apply()
        local c = Color3.fromRGB(cv.r, cv.g, cv.b)
        Settings.GUIColor    = c
        Preview.BackgroundColor3 = c
        FOVDraw.Color        = c
    end

    for i, d in ipairs(defs) do
        local yO = 40 + (i-1)*34

        local SLbl = Instance.new("TextLabel")
        SLbl.Text = d.l; SLbl.Font = Enum.Font.GothamBold; SLbl.TextSize = 11
        SLbl.TextColor3 = d.c; SLbl.BackgroundTransparency = 1
        SLbl.Size = UDim2.new(0,16,0,20); SLbl.Position = UDim2.new(0,14,0,yO)
        SLbl.TextXAlignment = Enum.TextXAlignment.Left; SLbl.Parent = Row

        local ST = Instance.new("Frame")
        ST.Size = UDim2.new(1,-70,0,6); ST.Position = UDim2.new(0,34,0,yO+7)
        ST.BackgroundColor3 = Color3.fromRGB(40,40,40); ST.BorderSizePixel = 0; ST.Parent = Row
        Instance.new("UICorner", ST).CornerRadius = UDim.new(1,0)

        local p0 = cv[d.k]/255
        local SF = Instance.new("Frame")
        SF.Size = UDim2.new(p0,0,1,0); SF.BackgroundColor3 = d.c
        SF.BorderSizePixel = 0; SF.Parent = ST
        Instance.new("UICorner", SF).CornerRadius = UDim.new(1,0)

        local SK = Instance.new("Frame")
        SK.Size = UDim2.new(0,12,0,12); SK.AnchorPoint = Vector2.new(0.5,0.5)
        SK.Position = UDim2.new(p0,0,0.5,0); SK.BackgroundColor3 = Color3.fromRGB(255,255,255)
        SK.BorderSizePixel = 0; SK.Parent = ST
        Instance.new("UICorner", SK).CornerRadius = UDim.new(1,0)

        local SVL = Instance.new("TextLabel")
        SVL.Text = tostring(cv[d.k]); SVL.Font = Enum.Font.Gotham; SVL.TextSize = 10
        SVL.TextColor3 = Color3.fromRGB(160,160,160); SVL.BackgroundTransparency = 1
        SVL.Size = UDim2.new(0,28,0,20); SVL.Position = UDim2.new(1,-36,0,yO)
        SVL.TextXAlignment = Enum.TextXAlignment.Right; SVL.Parent = Row

        local sdrag = false
        local key   = d.k

        local SC = Instance.new("TextButton")
        SC.Size = UDim2.new(1,0,1,0); SC.BackgroundTransparency = 1
        SC.Text = ""; SC.ZIndex = 10; SC.Parent = ST

        local function SCompute(ix)
            local abs = ST.AbsolutePosition.X
            local w   = ST.AbsoluteSize.X
            local pp  = math.clamp((ix-abs)/w, 0, 1)
            cv[key] = math.floor(pp*255)
            SF.Size      = UDim2.new(pp,0,1,0)
            SK.Position  = UDim2.new(pp,0,0.5,0)
            SVL.Text     = tostring(cv[key])
            Apply()
        end

        SC.MouseButton1Down:Connect(function(x) sdrag = true; SCompute(x) end)

        UserInputService.InputChanged:Connect(function(inp)
            if sdrag and inp.UserInputType == Enum.UserInputType.MouseMovement then
                SCompute(inp.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(inp)
            if inp.UserInputType == Enum.UserInputType.MouseButton1 then sdrag = false end
        end)
    end
end

