-- AIM SMOOTHNESS — float slider 0.01 → 1.00
--   Fixed: old code stored 1–30 then divided by 100 giving 0.01–0.30 and
--          showing "0.25" as label while the actual setting was int 25.
--          Now we store the true float directly.
MakeSlider(Tabs["SETTINGS"], "AIM SMOOTHNESS", "Smoothness", 1, 100, 2, false, function(val)
    Settings.Smoothness = val / 100  -- 0.01 → 1.00
end)

-- ══════════════════════════════════════════
--  AIMBOT CORE  — REWRITTEN
--  Fixed:
--    • mousemoverel is a Synapse/executor global; wrapped in pcall
--    • Wall check uses RaycastParams instead of deprecated FindPartOnRay
--    • Smoothness now correctly mapped (0.01–1.0)
--    • Target selection uses head when available for better accuracy
-- ══════════════════════════════════════════
local RayParams = RaycastParams.new()
RayParams.FilterType = Enum.RaycastFilterType.Exclude

local function GetTarget()
    local bestPart = nil
    local bestDist = Settings.FOVRadius
    local cx       = Camera.ViewportSize.X / 2
    local cy       = Camera.ViewportSize.Y / 2
    local center   = Vector2.new(cx, cy)

    RayParams.FilterDescendantsInstances = {LocalPlayer.Character or {}}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer then continue end
        if Settings.TeamCheck and plr.Team == LocalPlayer.Team then continue end

        local char = plr.Character
        if not char then continue end

        local head = char:FindFirstChild("Head")
        local hrp  = char:FindFirstChild("HumanoidRootPart")
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local part = head or hrp
        if not part or not hum or hum.Health <= 0 then continue end

        -- Wall check with modern RaycastParams
        if Settings.WallCheck then
            local origin    = Camera.CFrame.Position
            local direction = (part.Position - origin)
            local result    = workspace:Raycast(origin, direction, RayParams)
            if result and not result.Instance:IsDescendantOf(char) then continue end
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
        if not onScreen then continue end

        local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if dist < bestDist then
            bestDist = dist
            bestPart = part
        end
    end

    return bestPart
end

-- ══════════════════════════════════════════
--  MAIN RENDER LOOP
-- ══════════════════════════════════════════
RunService.RenderStepped:Connect(function()
    if not Settings.AimbotEnabled then return end

    local target = GetTarget()
    if not target then return end

    local screenPos, onScreen = Camera:WorldToViewportPoint(target.Position)
    if not onScreen then return end

    local cx = Camera.ViewportSize.X / 2
    local cy = Camera.ViewportSize.Y / 2

    -- delta from screen center to target (silent aim style — moves toward center)
    local dx = screenPos.X - cx
    local dy = screenPos.Y - cy

    -- apply smoothness (lower = slower lock)
    local moveX = dx * Settings.Smoothness
    local moveY = dy * Settings.Smoothness

    pcall(mousemoverel, moveX, moveY)
end)

-- ══════════════════════════════════════════
--  SILENT AIM HOOK
-- ══════════════════════════════════════════
if hookmetamethod then
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if not checkcaller() and key == "Hit" and self == Mouse then
            if Settings.SilentAim then
                local target = GetTarget()
                if target then
                    return CFrame.new(target.Position)
                end
            end
        end
        return oldIndex(self, key)
    end))
end
